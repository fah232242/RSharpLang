import vec;
let a = vec.vec2(3.0, 4.0);
print(vec.len2(a), vec.norm2(vec.vec2(0.0, 5.0)), vec.dist2(a, vec.vec2(0.0, 0.0)));   // expect: 5.0 Vec2(x=0.0, y=1.0) 5.0
print(vec.lerp2(vec.vec2(0.0, 0.0), vec.vec2(10.0, 20.0), 0.5));      // expect: Vec2(x=5.0, y=10.0)
let c = vec.cross3(vec.vec3(1.0, 0.0, 0.0), vec.vec3(0.0, 1.0, 0.0));
print(c, vec.dot3(c, c));                                             // expect: Vec3(x=0.0, y=0.0, z=1.0) 1.0
let v: Vec2 = Vec2 { x: 1.0, y: 2.0 };
print(vec.add2(v, v));                                                // expect: Vec2(x=2.0, y=4.0)
