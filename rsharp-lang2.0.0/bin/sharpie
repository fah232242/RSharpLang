#!/bin/sh
# sharpie: friendly front-end for `rsharp pkg` and the build/run commands.
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
R() { PYTHONPATH="$ROOT" exec python3 -m rsharp "$@"; }
cmd="$1"; [ $# -gt 0 ] && shift
case "$cmd" in
  new)      R pkg new game "$@" ;;
  init|add|remove|update|list|search|audit|publish) R pkg "$cmd" "$@" ;;
  install)  if [ $# -gt 0 ]; then R pkg add "$@"; else R pkg update; fi ;;
  run|build|test|check) R "$cmd" "$@" ;;
  --version|-V) R --version ;;
  *) echo "usage: sharpie new|init|add|remove|update|list|search|audit|install|run|build|test"; exit 2 ;;
esac
