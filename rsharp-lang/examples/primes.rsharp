fn is_prime(n: int) -> bool {
    if n < 2 { return false; }
    mut d = 2;
    while d * d <= n {
        if n % d == 0 { return false; }
        d += 1;
    }
    return true;
}

fn main() {
    mut primes: int[] = [];
    for n in 0..60 {
        if is_prime(n) { primes.push(n); }
    }
    print($"{primes.length} primes below 60:", primes);
}
